#!/bin/sh
# speccy's command line from this checkout, run in the caller's directory.
# Compiles quietly first and shows the output only when compiling fails.
root=$(cd "$(dirname "$(realpath "$0")")/.." && pwd)
here=$PWD
cd "$root" || exit 2
out=$(mix compile 2>&1) || { printf '%s\n' "$out" >&2; exit 2; }
SPECCY_CWD=$here exec mix run --no-compile --no-start \
  -e 'File.cd!(System.fetch_env!("SPECCY_CWD")); Speccy.CLI.main(System.argv())' -- "$@"
