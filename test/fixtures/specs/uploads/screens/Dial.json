{
  "$schema": "https://raw.githubusercontent.com/tinyish/speccy/main/priv/schemas/1/screen.schema.json",
  "screen": "Dial",
  "about": "How many uploads are left, on the round dial.",
  "device": "dial",
  "data": {
    "left": {
      "type": "number",
      "sample": 3
    },
    "sel": {
      "type": "text",
      "sample": "shown"
    }
  },
  "layout": "row",
  "wrap": true,
  "align": "center",
  "lineGap": 4,
  "clip": true,
  "children": [
    {
      "id": "count",
      "use": "progress",
      "props": {
        "label": "Uploads left"
      },
      "bind": {
        "value": "left"
      }
    },
    {
      "id": "tabs",
      "use": "Tabs"
    },
    {
      "id": "picker",
      "use": "container",
      "props": {
        "role": "tablist"
      },
      "children": [
        {
          "id": "pickTab",
          "use": "container",
          "props": {
            "pressable": true,
            "role": "tab"
          },
          "bind": {
            "controls": "sel"
          }
        }
      ]
    },
    {
      "id": "shown",
      "use": "container",
      "props": {
        "role": "tabpanel"
      }
    }
  ],
  "states": {
    "last": {
      "about": "One upload left.",
      "data": {
        "left": 1
      },
      "children": [
        {
          "copy": "count"
        }
      ]
    }
  }
}
