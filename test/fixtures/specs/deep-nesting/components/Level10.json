{
  "$schema": "https://raw.githubusercontent.com/tinyish/speccy/main/priv/schemas/1/component.schema.json",
  "component": "Level10",
  "about": "Level 10 of a deep chain, passing on down.",
  "props": {
    "on": {
      "type": "bool",
      "default": false
    }
  },
  "children": [
    {
      "id": "next",
      "use": "Level11",
      "bind": {
        "on": "on"
      }
    }
  ],
  "states": {
    "pressed": {
      "about": "Pressed, as in its base.",
      "children": [
        {
          "copy": "next"
        }
      ]
    },
    "busy": {
      "about": "Busy, as in its base.",
      "children": [
        {
          "copy": "next"
        }
      ]
    }
  }
}
