{
  "name": "image",
  "about": "A picture, with a fallback (such as initials) shown when it has no source or it fails to load.",
  "category": "media",
  "element": "img (fallback when there is no src or it fails)",
  "props": {
    "src": "text",
    "alt": "text",
    "fallback": "text"
  },
  "events": {},
  "children": false,
  "states": {
    "broken": {
      "src": ""
    }
  },
  "defaults": {
    "src": "photos/maya-chen.jpg",
    "alt": "Maya Chen",
    "fallback": "MC"
  },
  "render": {
    "el": "div",
    "class": "wf-box wf-row",
    "attrs": {
      "role": "img",
      "aria-label": "{alt}",
      "style": "width:64px;height:64px;justify-content:center"
    },
    "children": [
      {
        "el": "span",
        "class": "wf-icon",
        "if": "src"
      },
      {
        "el": "span",
        "class": "wf-strong wf-muted",
        "if": "!src",
        "text": "{fallback}"
      }
    ]
  },
