{
  "name": "button",
  "about": "A control the user presses to run an action. It can stay selected like a toggle, carry a menu of related actions, or be removed, so small buttons also cover tags, chips and badges.",
  "category": "actions",
  "element": "button (aria-pressed when selected; icon-only when it has no text, named by label; plus a menu button, aria-haspopup=menu, when it has options; plus a remove button when removable)",
  "props": {
    "text": "text",
    "label": "text",
    "leadingIcon": "text",
    "trailingIcon": "text",
    "size": [
      "sm",
      "md",
      "lg"
    ],
    "selected": "bool",
    "disabled": "bool",
    "options": "text[]",
    "open": "bool",
    "removable": "bool"
  },
  "events": {
    "press": null,
    "select": "text",
    "remove": null
  },
  "children": false,
  "states": {
    "selected": {
      "selected": true
    },
    "disabled": {
      "disabled": true
    },
    "open": {
      "options": [
        "Save as draft",
        "Save and close",
        "Save a copy"
      ],
      "open": true
    }
  },
  "examples": {
    "small": {
      "size": "sm"
    },
    "large": {
      "size": "lg"
    },
    "with icons": {
      "leadingIcon": "save",
      "trailingIcon": "expand_more"
    },
    "icon only": {
      "text": "",
      "leadingIcon": "favorite",
      "label": "Favourite"
    },
    "icon only selected": {
      "text": "",
      "leadingIcon": "favorite",
      "label": "Favourite",
      "selected": true
    },
    "removable tag": {
      "size": "sm",
      "text": "Design",
      "removable": true
    }
  },
  "defaults": {
    "text": "Save changes",
    "label": "Save changes",
    "leadingIcon": "",
    "trailingIcon": "",
    "size": "md",
    "selected": false,
    "disabled": false,
    "options": [],
    "open": false,
    "removable": false
  },
  "render": {
    "el": "div",
    "class": "wf-col wf-gap",
    "attrs": {
      "style": "align-items:flex-start"
    },
    "children": [
      {
        "el": "div",
        "class": "wf-row",
        "attrs": {
          "style": "gap:1px"
        },
        "children": [
          {
            "el": "button",
            "class": "wf-btn",
            "classIf": {
              "wf-btn-sm": "size=sm",
              "wf-btn-lg": "size=lg",
              "wf-btn-icon": "!text",
              "wf-selected": "selected",
              "wf-disabled": "disabled"
            },
            "attrs": {
              "type": "button",
              "aria-label": "{label}",
              "aria-pressed": "{selected}",
              "disabled": "{disabled}"
            },
            "children": [
              {
                "el": "span",
                "class": "wf-symbol",
                "if": "leadingIcon",
                "text": "{leadingIcon}",
                "attrs": {
                  "aria-hidden": "true"
                }
              },
              {
                "el": "span",
                "class": "wf-icon",
                "if": "!text.length + leadingIcon.length + trailingIcon.length",
                "attrs": {
                  "aria-hidden": "true"
                }
              },
              {
                "el": "span",
                "if": "text",
                "text": "{text}"
              },
              {
                "el": "span",
                "class": "wf-symbol",
                "if": "trailingIcon",
                "text": "{trailingIcon}",
                "attrs": {
                  "aria-hidden": "true"
                }
              }
            ]
          },
          {
            "el": "button",
            "if": "options",
            "class": "wf-btn wf-btn-icon",
            "classIf": {
              "wf-btn-sm": "size=sm",
              "wf-btn-lg": "size=lg",
              "wf-disabled": "disabled"
            },
            "attrs": {
              "type": "button",
              "aria-haspopup": "menu",
              "aria-expanded": "{open}",
              "aria-label": "More options",
              "disabled": "{disabled}"
            },
            "children": [
              {
                "el": "span",
                "class": "wf-symbol",
                "text": "expand_more",
                "attrs": {
                  "aria-hidden": "true"
                }
              }
            ]
          },
          {
            "el": "button",
            "if": "removable",
            "class": "wf-btn wf-btn-icon",
            "classIf": {
              "wf-btn-sm": "size=sm",
              "wf-btn-lg": "size=lg",
              "wf-disabled": "disabled"
            },
            "attrs": {
              "type": "button",
              "aria-label": "Remove",
              "disabled": "{disabled}"
            },
            "children": [
              {
                "el": "span",
                "class": "wf-symbol",
                "text": "close",
                "attrs": {
                  "aria-hidden": "true"
                }
              }
            ]
          }
        ]
      },
      {
        "el": "ul",
        "class": "wf-overlay wf-col",
        "if": "open",
        "attrs": {
          "role": "menu",
          "style": "align-items:stretch"
        },
        "children": [
          {
            "el": "li",
            "class": "wf-pad",
            "each": "options",
            "text": "{item}",
            "attrs": {
              "role": "menuitem"
            }
          }
        ]
      }
    ]
  },
