{
  "name": "list",
  "about": "A column of items the user scans, selects, reorders or swipes for actions.",
  "category": "data-display",
  "element": "ul",
  "props": {
    "selectable": "bool",
    "reorderable": "bool",
    "selected": "bool"
  },
  "events": {
    "select": "text",
    "reorder": "text[]",
    "swipe": "text"
  },
  "children": true,
  "states": {
    "selected": {
      "selectable": true,
      "selected": true
    }
  },
  "defaults": {
    "selectable": false,
    "reorderable": false,
    "selected": false
  },
  "render": {
    "el": "ul",
    "class": "wf-col wf-box",
    "children": [
      {
        "el": "li",
        "if": "selected",
        "class": "wf-row wf-gap wf-pad wf-selected",
        "attrs": {
          "aria-selected": "{selected}",
          "style": "width:100%"
        },
        "children": [
          {
            "el": "span",
            "class": "wf-icon",
            "attrs": {
              "aria-label": "Drag"
            },
            "if": "reorderable"
          },
          {
            "el": "span",
            "class": "wf-grow",
            "text": "Selected item"
          }
        ]
      },
      {
        "el": "li",
        "class": "wf-row wf-gap wf-pad",
        "attrs": {
          "style": "width:100%"
        },
        "children": [
          {
            "el": "span",
            "class": "wf-icon",
            "attrs": {
              "aria-label": "Drag"
            },
            "if": "reorderable"
          },
          {
            "el": "div",
            "class": "wf-col wf-gap wf-grow",
            "slot": true
          }
        ]
      }
    ]
  },
  "sources": {
