{
  "name": "menu",
  "about": "A list of actions or choices the user opens from a button, or by right-clicking an area, and picks one from.",
  "category": "overlays",
  "element": "role=menu (from a button, or opened by contextmenu on the area it wraps)",
  "props": {
    "items": "text[]",
    "value": "text",
    "searchable": "bool",
    "open": "bool",
    "trigger": [
      "click",
      "contextmenu"
    ]
  },
  "events": {
    "select": "text",
    "close": null
  },
  "children": true,
  "states": {
    "open": {
      "open": true
    }
  },
  "defaults": {
    "items": [
      "Sort by name",
      "Sort by date",
      "Sort by size"
    ],
    "value": "Sort by date",
    "searchable": false,
    "open": false,
    "trigger": "click"
  },
  "render": {
    "el": "div",
    "class": "wf-col wf-gap",
    "attrs": {
      "style": "align-items:flex-start"
    },
    "children": [
      {
        "el": "button",
        "class": "wf-btn",
        "text": "Sort ▾",
        "classIf": {
          "wf-selected": "open"
        },
        "attrs": {
          "aria-haspopup": "menu",
          "aria-expanded": "{open}"
        },
        "if": "trigger=click"
      },
      {
        "el": "div",
        "class": "wf-box wf-pad",
        "if": "trigger=contextmenu",
        "slot": true
      },
      {
        "el": "div",
        "class": "wf-overlay wf-col",
        "if": "open",
        "attrs": {
          "role": "menu",
          "style": "min-width:180px;align-items:stretch"
        },
        "children": [
          {
            "el": "div",
            "class": "wf-pad",
            "if": "searchable",
            "children": [
              {
                "el": "input",
                "class": "wf-field",
                "attrs": {
                  "placeholder": "Search",
                  "style": "width:100%"
                }
              }
            ]
          },
          {
            "el": "div",
            "class": "wf-pad wf-row wf-gap",
            "each": "items",
            "attrs": {
              "role": "menuitemradio"
            },
            "children": [
              {
                "el": "span",
                "class": "wf-small",
                "attrs": {
                  "style": "width:12px"
                },
                "children": [
                  {
                    "el": "span",
                    "if": "item={value}",
                    "text": "✓"
                  }
                ]
              },
              {
                "el": "span",
                "text": "{item}"
              }
            ]
          }
        ]
      }
    ]
  },
  "sources": {
    "material": [
      {
