        "nodeId": "1227:110587",
        "url": "https://www.figma.com/design/cSwRpauaKiABArOhGxWNTb/?node-id=1227-110587"
      },
      {
        "name": "Table header cell (sub-part: header cell)",
        "nodeId": "1221:107933",
        "url": "https://www.figma.com/design/cSwRpauaKiABArOhGxWNTb/?node-id=1221-107933"
      },
      {
        "name": "Table cell (sub-part: cell)",
        "nodeId": "1222:107305",
        "url": "https://www.figma.com/design/cSwRpauaKiABArOhGxWNTb/?node-id=1222-107305"
      },
      {
        "name": "Table cell lead action (sub-part: row select)",
        "nodeId": "9400:570197",
        "url": "https://www.figma.com/design/cSwRpauaKiABArOhGxWNTb/?node-id=9400-570197"
      }
    ]
  }
}
