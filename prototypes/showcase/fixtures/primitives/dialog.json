      },
      {
        "name": "Side Sheet",
        "nodeId": "53198:27851",
        "url": "https://www.figma.com/design/bteAzHXqWruFD9xnndiAGK/?node-id=53198-27851"
      },
      {
        "name": "Bottom sheet",
        "nodeId": "51827:5859",
        "url": "https://www.figma.com/design/bteAzHXqWruFD9xnndiAGK/?node-id=51827-5859"
      }
    ],
    "untitled": [
      {
        "name": "Modal",
        "nodeId": "4057:415205",
        "url": "https://www.figma.com/design/cSwRpauaKiABArOhGxWNTb/?node-id=4057-415205"
      },
      {
        "name": "Slide out menu",
        "nodeId": "1240:137582",
        "url": "https://www.figma.com/design/cSwRpauaKiABArOhGxWNTb/?node-id=1240-137582"
      }
    ]
  }
}
